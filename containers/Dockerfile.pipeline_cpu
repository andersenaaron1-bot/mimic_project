ARG PYTHON_VERSION=3.11
FROM python:${PYTHON_VERSION}-slim

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1

SHELL ["/bin/bash", "-lc"]

RUN apt-get update && apt-get install -y --no-install-recommends \
      bash ca-certificates age zstd openssl procps git build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/ehr-hier

ARG TORCH_VERSION=2.5.1
ARG MEDS_READER_VERSION=0.1.14
RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install --index-url https://download.pytorch.org/whl/cpu "torch==${TORCH_VERSION}+cpu" && \
    pip install \
      numpy \
      pandas \
      pyarrow \
      polars \
      pyyaml \
      tqdm \
      pydantic \
      hydra-core==1.3.2 \
      omegaconf==2.3.0 && \
    pip install "meds_reader~=${MEDS_READER_VERSION}" && \
    python -c "import meds_reader, torch, pyarrow, polars; print('pipeline-cpu deps OK')" && \
    meds_reader_convert --help >/dev/null

ENV PYTHONPATH=/workspace/ehr-hier${PYTHONPATH:+:${PYTHONPATH}}

ENTRYPOINT []
CMD ["bash"]
